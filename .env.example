# LinkedIn OAuth app credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# MCP server API key for authentication.
# Set this to a strong random value and pass it as: Authorization: Bearer <API_KEY>
API_KEY=your_secret_api_key

# Must exactly match a redirect URL registered in the LinkedIn Developer Portal.
# In production this should be your public HTTPS URL.
LINKEDIN_REDIRECT_URI=https://your-domain.example/auth/linkedin/callback

# Public base URL for links returned by the server.
BASE_URL=https://your-domain.example

# HTTP server settings
PORT=3000
HOST=0.0.0.0

# Space-delimited LinkedIn OAuth scopes for this app.
# Keep this as small as possible and only request scopes your app has been approved for.
LINKEDIN_SCOPES=r_liteprofile w_member_social

# Persistent token store location inside the container or host volume.
LINKEDIN_TOKEN_STORE=/data/linkedin-token.json